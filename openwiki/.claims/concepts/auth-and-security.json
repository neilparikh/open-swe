    {
      "id": "claim_07e4e2f585a04e2bafd3ed52a8dd654c",
      "statement": "The dashboard OAuth flow binds a random browser nonce by storing its HMAC in a signed state JWT and the raw value in `osw_oauth_state`; the callback constant-time compares them before exchanging the GitHub code, enforcing the login gate, persisting credentials, and issuing a session or desktop handoff.",
      "evidence": [
        {
          "resource": "repo://openswe/dashboard/auth_routes.py#L145-L198",
          "version": "repo-lines-v1:sha256:ec5fabc32cb0a93f420a3847379bab2e81c4647e534bc43f5e25d01084905df1:"
        },
