        {
          "resource": "repo://openswe/github/routes.py#L29-L100",
          "version": "repo-lines-v1:sha256:641f77827501bbd0e8ec3c49670f00d330be4a6224326cba1b5ab54c2b010ff0:"
        }
      ]
    },
