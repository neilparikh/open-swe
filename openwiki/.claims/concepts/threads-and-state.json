    {
      "id": "claim_d4721e40d6c14d00ad227ef03f2d71d7",
      "statement": "Follow-up messages are PostgreSQL rows rather than a shared Store list: each insert is ordered by an identity sequence, dashboard queue IDs deduplicate retries per thread, and the queue retains at most 100 newest entries by deleting older rows.",
